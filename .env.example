# MongoDB
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/smile-webhook

# GHL
GHL_API_KEY=your_ghl_private_integration_or_api_key
# (Location ID is usually implied by the API key/contact, but keep it handy)
GHL_LOCATION_ID=vDM9L71zA6LpZHZCnYqb

# Gemini
GEMINI_API_KEY=your_gemini_api_key

# AWS S3 (or swap storage.js for Cloudflare R2 / Cloudinary if you prefer)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
S3_BUCKET_NAME=your-bucket-name
S3_PUBLIC_BASE_URL=https://your-bucket-name.s3.ap-south-1.amazonaws.com

PORT=3000
